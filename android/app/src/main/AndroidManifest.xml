<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Wallpaper background layer: up to Android 12, reading the real
         home-screen wallpaper via WallpaperManager requires this permission.
         Android 13 returns the default wallpaper and Android 14+ refuses the
         call entirely (except MANAGE_EXTERNAL_STORAGE holders, which this
         template deliberately does not request), so no permission is declared
         for those versions. READ_MEDIA_IMAGES never applied to this API and
         must not be declared or requested for it. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Preview notification posted from the settings page. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LiquidUI">

        <!--
          真实主界面：不加 launcher intent-filter。
          Launcher 入口由下面的 activity-alias 承担（应用图标切换功能点）。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 图标 1 · 默认（冰蓝）· 当前生效 -->
        <activity-alias
            android:name=".icon.Default"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 图标 2 · 星夜 · 默认禁用 -->
        <activity-alias
            android:name=".icon.Galaxy"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_galaxy"
            android:roundIcon="@mipmap/ic_launcher_galaxy"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 图标 3 · 珊瑚 · 默认禁用 -->
        <activity-alias
            android:name=".icon.Coral"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_coral"
            android:roundIcon="@mipmap/ic_launcher_coral"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

    </application>

</manifest>
