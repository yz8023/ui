<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Wallpaper background layer (same setup as the pan-x/YunX app, whose
         system-wallpaper mode this mirrors):
         - Up to Android 12, reading the real home-screen wallpaper via
           WallpaperManager requires READ_EXTERNAL_STORAGE.
         - Android 14+ refuses WallpaperManager.getDrawable() entirely
           *unless* the app holds "all files access" (MANAGE_EXTERNAL_STORAGE,
           granted only from a system settings page — there is no runtime
           dialog). pan-x declares it for its download feature and guides
           users to enable it; that grant is what makes its system wallpaper
           work on modern Android, so it is declared here for the same call.
         - READ_MEDIA_IMAGES never applied to this API; do not re-add it. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Preview notification posted from the settings page. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 应用内更新检查（手册 F18 / 条目 U01）：下载 APK 后调起系统安装器需要这个权限。
         Android 8+ 还要用户在系统设置里授予「安装未知应用」，代码里已做检查与引导，
         未授权时不会静默失败。宿主如果不做自更新，删掉这行与下面的 provider 即可。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LiquidUI">

        <!--
          真实主界面：不加 launcher intent-filter。
          Launcher 入口由下面的 activity-alias 承担（应用图标切换功能点）。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 图标 1 · 默认（冰蓝）· 当前生效 -->
        <activity-alias
            android:name=".icon.Default"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 图标 2 · 星夜 · 默认禁用 -->
        <activity-alias
            android:name=".icon.Galaxy"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_galaxy"
            android:roundIcon="@mipmap/ic_launcher_galaxy"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 图标 3 · 珊瑚 · 默认禁用 -->
        <activity-alias
            android:name=".icon.Coral"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_coral"
            android:roundIcon="@mipmap/ic_launcher_coral"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 更新检查（F18/U01）：把私有缓存里的 APK 以 content:// 形式交给系统安装器。
             Android 7+ 禁止 file:// 跨应用暴露（FileUriExposedException），必须走 FileProvider。
             路径规则见 res/xml/file_paths.xml。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
