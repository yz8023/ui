    <string name="common_library_subtitle">Android 功能素材库</string>
    <string name="common_permissions">权限管理</string>
    <string name="info_desc_1">用于你主动触发的主题预览通知。</string>
    <string name="info_desc_2">仅在启用桌面壁纸背景时读取系统返回的壁纸图像。</string>
    <string name="info_section_title_1">参考项目与作者</string>
    <string name="info_section_title_2">数据处理</string>
    <string name="info_subtitle_1">完整列出直接参考的项目、作者、用途与许可证，尊重每一位开源作者。</string>
    <string name="info_subtitle_2">逐项说明数据保存位置、权限用途和网络行为。</string>
    <string name="info_subtitle_3">权限不是介绍弹窗：可在这里真实请求、检查授权状态，并在拒绝后进入系统设置恢复。</string>
    <string name="info_text_1">‹ 返回</string>
    <string name="info_text_10">网络与账号</string>
    <string name="info_text_11">应用没有账号、分析、广告、遥测或后台上传功能。点击项目链接时会交给系统浏览器打开。</string>
    <string name="info_text_12">权限撤回</string>
    <string name="info_text_13">可随时在 Android 系统设置的“应用信息 → 权限”中撤回授权；撤回不影响其他离线功能。</string>
    <string name="info_text_14">系统壁纸权限</string>
    <string name="info_text_15">读取系统壁纸不使用媒体图片权限（该权限对 WallpaperManager 无效，旧版曾误用）。Android 14 起系统只允许持有「所有文件访问」的 app 读取桌面壁纸——请在设置页「壁纸与背景 → 系统壁纸」处点按钮，跳到系统设置里为本 app 开启；开启后返回即生效，不需要时可随时关闭。</string>
    <string name="info_text_16">Android 12 及以下无需单独申请通知运行时权限。</string>
    <string name="info_text_17">最小权限原则</string>
    <string name="info_text_18">应用不申请位置、相机、麦克风、通讯录或电话权限。所有权限均由明确的用户操作触发。</string>
    <string name="info_text_2">Liquid Motion UI 示例应用</string>
    <string name="info_text_3">本项目自身代码采用 MIT 许可证。若复制或分发上游代码，请同时遵守对应上游许可证并保留署名。</string>
    <string name="info_text_4">查看本项目源码与 CREDITS.md</string>
    <string name="info_text_5">本地偏好</string>
    <string name="info_text_6">主题、动效、桌面图标与引导完成状态仅保存在设备本地 SharedPreferences，不会上传。</string>
    <string name="info_text_7">壁纸读取</string>
    <string name="info_text_8">系统壁纸仅通过 WallpaperManager 在本机读取并绘制，不保存、不上传。Android 12 及以下读取真实壁纸需要存储读取权限；Android 14 起系统只允许持有「所有文件访问」的 app 读取桌面壁纸，应用会在系统壁纸设置处引导你在系统设置中开启（可随时关闭），未开启前自动回退内置背景，本地图片与网络壁纸不受影响。</string>
    <string name="info_text_9">仅在你点击“发送测试通知”时申请通知权限并创建本地通知，不向服务器发送数据。</string>
