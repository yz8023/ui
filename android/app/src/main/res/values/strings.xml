    <!-- ===== ui/features/overlayterms/OverlayTermsDemo.kt ===== -->
    <string name="common_processing">处理中…</string>
    <string name="ot_demo_text_1">Alert = 阻塞式告知：只有一个「知道了」，不征求选择。</string>
    <string name="ot_demo_text_10">发一条系统 Toast（真 Toast.makeText）</string>
    <string name="ot_demo_text_11">已保存到草稿</string>
    <string name="ot_demo_text_12">显示自绘轻提示（可定制样式，2.2s 自动消失）</string>
    <string name="ot_demo_text_13">已复制到剪贴板</string>
    <string name="ot_demo_text_14">要品牌样式/多条堆叠就自绘，但语义不能变：仍然不可交互、自动消失。</string>
    <string name="ot_demo_text_15">反例对照：报错别用 Toast（读不完且无法重试）——该用 Snackbar（P07）或内联错误。</string>
    <string name="ot_demo_text_16">Modal = 带遮罩的小房间：必须在里面完成或明确放弃，才能回主流程。</string>
    <string name="ot_demo_text_17">点外面不可关（防丢数据）</string>
    <string name="ot_demo_text_18">点外面可关</string>
    <string name="ot_demo_text_19">打开 Modal：重命名项目</string>
    <string name="ot_demo_text_2">不可绕过（点外面/返回键都关不掉）</string>
    <string name="ot_demo_text_20">未命名项目</string>
    <string name="ot_demo_text_21">含输入框的 Modal 一定要给「取消」，且主按钮在内容为空时禁用。</string>
    <string name="ot_demo_text_22">反例对照：Modal 里装长列表/设置页 → 该用 Drawer（P04）或 BottomSheet（P10）。</string>
    <string name="ot_demo_text_23">重命名项目</string>
    <string name="ot_demo_text_24">项目名称</string>
    <string name="ot_demo_text_25">这是 Modal：背景被遮罩挡住、焦点关在框内，必须处理完才能回去。</string>
    <string name="ot_demo_text_26">保存</string>
    <string name="ot_demo_text_27">Drawer = 从边缘滑出的面板，承载导航或一批内容；遮罩透明度与面板位移共用同一 progress。</string>
    <string name="ot_demo_text_28">主页面内容</string>
    <string name="ot_demo_text_29">打开抽屉</string>
    <string name="ot_demo_text_3">可绕过</string>
    <string name="ot_demo_text_30">点遮罩、按返回键都能关；面板宽 210dp 固定，不用百分比像素写死。</string>
    <string name="ot_demo_text_31">导航</string>
    <string name="ot_demo_text_32">概览</string>
    <string name="ot_demo_text_33">订单</string>
    <string name="ot_demo_text_34">报表</string>
    <string name="ot_demo_text_35">成员</string>
    <string name="ot_demo_text_36">反例对照：手机竖屏用左侧 Drawer 装长表单 → 该用 BottomSheet（P10）或独立页。</string>
    <string name="ot_demo_text_37">Popconfirm = 贴着按钮的小气泡，就地二次确认轻量操作，不遮整页。</string>
    <string name="ot_demo_text_38">列表已空。点下面的「恢复全部」再来一遍。</string>
    <string name="ot_demo_text_39">恢复全部</string>
    <string name="ot_demo_text_4">弹出 Alert：存储即将写满</string>
    <string name="ot_demo_text_40">Android 对应：DropdownMenu 自动锚定并在空间不足时翻到上方；要自定义箭头/位置才用底层 Popup。</string>
    <string name="ot_demo_text_41">反例对照：确认「清空全部数据」这种重操作 → 该用 Modal（P03）写清后果。</string>
    <string name="ot_demo_text_42">Tooltip = 纯文字注解，长按出现、自动消失、不可交互。移动端没有 hover，等价触发是长按。</string>
    <string name="ot_demo_text_43">控制是否推送与免打扰时段</string>
    <string name="ot_demo_text_44">上次同步 12 分钟前，仅 Wi-Fi 下自动</string>
    <string name="ot_demo_text_45">已禁用：需要先完成实名认证</string>
    <string name="ot_demo_text_46">长按任意图标试试：1.8s 后自动消失，点外部也可关。</string>
    <string name="ot_demo_text_47">无障碍要点：图标已设 contentDescription，读屏拿得到同样信息——必要说明不能只藏在 Tooltip 里。</string>
    <string name="ot_demo_text_48">反例对照：Tooltip 里塞按钮/链接 → 那是 Popover（P09）。</string>
    <string name="ot_demo_text_49">Snackbar = 应用内底部条幅，可带一个操作；删除后给「撤销」是它的典型用法。</string>
    <string name="ot_demo_text_5">反例对照：把「保存成功」做成 Alert 就是滥用——那该是 Toast（P02）。</string>
    <string name="ot_demo_text_50">三条草稿都删完了。等 Snackbar 消失后重进本页可复位。</string>
    <string name="ot_demo_text_51">恢复全部草稿</string>
    <string name="ot_demo_text_52">反例对照：Snackbar 里放两个以上操作 → 那已经是工具栏了；报致命错误 → 用 Modal（P03）。</string>
    <string name="ot_demo_text_53">已授权，现在点「发送真实通知」能收到</string>
    <string name="ot_demo_text_54">被拒绝：Android 13+ 通知发不出去，需到系统设置手动开启</string>
    <string name="ot_demo_text_55">Popover = 锚定的富内容气泡：可放菜单项、开关、输入；Tooltip 的「能干活」版本。</string>
    <string name="ot_demo_text_56">更多操作 ⋯</string>
    <string name="ot_demo_text_57">生成链接发给同事</string>
    <string name="ot_demo_text_58">CSV / PDF 两种格式</string>
    <string name="ot_demo_text_59">从列表移走但可恢复</string>
    <string name="ot_demo_text_6">存储即将写满</string>
    <string name="ot_demo_text_60">接收通知</string>
    <string name="ot_demo_text_61">气泡内每行热区 ≥44dp；内容超过 6 项或需要滚动时改用 BottomSheet（P10）。</string>
    <string name="ot_demo_text_62">反例对照：气泡里再弹气泡、或点外部不关闭，都是常见错法。</string>
    <string name="ot_demo_text_63">BottomSheet / ActionSheet = 从底部升起的面板；移动端比 Drawer 顺手，拇指够得到。</string>
    <string name="ot_demo_text_64">打开动作面板（ActionSheet）</string>
    <string name="ot_demo_text_65">面板可半展开（露一半）与全展开两档，拖把手可切换；下拉关闭与内部滚动不打架。</string>
    <string name="ot_demo_text_66">反例对照：ActionSheet 不给「取消」项，或把整页内容塞进面板造成滚动嵌套。</string>
    <string name="ot_demo_text_67">分享到微信</string>
    <string name="ot_demo_text_68">复制链接</string>
    <string name="ot_demo_text_69">导出 PDF</string>
    <string name="ot_demo_text_7">剩余空间不足 200MB，继续录制可能中断。这是 Alert：只告知事实，不让你选。</string>
    <string name="ot_demo_text_70">移动到归档</string>
    <string name="ot_demo_text_71">删除</string>
    <string name="ot_demo_text_72">加载反馈分三档强度：非阻塞 → 按钮内 → 全局遮罩。强度越高越要给进度与取消。</string>
    <string name="ot_demo_text_73">非阻塞</string>
    <string name="ot_demo_text_74">按钮内</string>
    <string name="ot_demo_text_75">全局遮罩</string>
    <string name="ot_demo_text_76">顶部细进度条：用户仍可继续操作，适合后台刷新/分页加载。</string>
    <string name="ot_demo_text_77">提交表单</string>
    <string name="ot_demo_text_78">开始关键操作</string>
    <string name="ot_demo_text_79">后台刷新</string>
    <string name="ot_demo_text_8">知道了</string>
    <string name="ot_demo_text_80">按钮加载态：宽度不变（只换文案 + 16dp 圆环），防止布局跳动；同时禁止重复提交。</string>
    <string name="ot_demo_text_81">全局遮罩必须给取消或超时兜底，否则网络一断就永远转圈。</string>
    <string name="ot_demo_text_82">反例对照：点一下按钮就整页转圈；加载完不给结果反馈（应接 Toast/Snackbar）。</string>
    <string name="ot_demo_text_83">Badge = 附着在图标上的持续状态：不弹出、不打断，被消费后才消失。</string>
    <string name="ot_demo_text_84">有更新</string>
    <string name="ot_demo_text_85">无更新</string>
    <string name="ot_demo_text_86">计数角标 vs 红点</string>
    <string name="ot_demo_text_87">数字用于「有多少」，红点用于「有更新但不计数」</string>
    <string name="ot_demo_text_88">设为 100</string>
    <string name="ot_demo_text_89">清零</string>
    <string name="ot_demo_text_9">Toast = 最弱反馈：不打断、无按钮、自动消失。</string>
    <string name="ot_demo_text_90">红点开</string>
    <string name="ot_demo_text_91">规则：count &gt; 99 显示「99+」；count == 0 时整个角标不渲染，不是显示「0」。</string>
    <string name="ot_demo_text_92">反例对照：红点永远消不掉（没有消费逻辑）、角标遮住图标主体超过 1/3。</string>

