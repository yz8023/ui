    <!-- ===== ui/features/overlayterms/OverlayTermsDemo.kt ===== -->
    <string name="ot_demo_text_1">Alert = 阻塞式告知：只有一个「知道了」，不征求选择。</string>
    <string name="ot_demo_text_10">发一条系统 Toast（真 Toast.makeText）</string>
    <string name="ot_demo_text_11">显示自绘轻提示（可定制样式，2.2s 自动消失）</string>
    <string name="ot_demo_text_12">要品牌样式/多条堆叠就自绘，但语义不能变：仍然不可交互、自动消失。</string>
    <string name="ot_demo_text_13">反例对照：报错别用 Toast（读不完且无法重试）——该用 Snackbar（P07）或内联错误。</string>
    <string name="ot_demo_text_14">Modal = 带遮罩的小房间：必须在里面完成或明确放弃，才能回主流程。</string>
    <string name="ot_demo_text_15">点外面不可关（防丢数据）</string>
    <string name="ot_demo_text_16">点外面可关</string>
    <string name="ot_demo_text_17">打开 Modal：重命名项目</string>
    <string name="ot_demo_text_18">含输入框的 Modal 一定要给「取消」，且主按钮在内容为空时禁用。</string>
    <string name="ot_demo_text_19">反例对照：Modal 里装长列表/设置页 → 该用 Drawer（P04）或 BottomSheet（P10）。</string>
    <string name="ot_demo_text_2">不可绕过（点外面/返回键都关不掉）</string>
    <string name="ot_demo_text_20">重命名项目</string>
    <string name="ot_demo_text_21">项目名称</string>
    <string name="ot_demo_text_22">这是 Modal：背景被遮罩挡住、焦点关在框内，必须处理完才能回去。</string>
    <string name="ot_demo_text_23">保存</string>
    <string name="ot_demo_text_24">Drawer = 从边缘滑出的面板，承载导航或一批内容；遮罩透明度与面板位移共用同一 progress。</string>
    <string name="ot_demo_text_25">主页面内容</string>
    <string name="ot_demo_text_26">打开抽屉</string>
    <string name="ot_demo_text_27">点遮罩、按返回键都能关；面板宽 210dp 固定，不用百分比像素写死。</string>
    <string name="ot_demo_text_28">导航</string>
    <string name="ot_demo_text_29">概览</string>
    <string name="ot_demo_text_3">可绕过</string>
    <string name="ot_demo_text_30">订单</string>
    <string name="ot_demo_text_31">报表</string>
    <string name="ot_demo_text_32">成员</string>
    <string name="ot_demo_text_33">设置</string>
    <string name="ot_demo_text_34">反例对照：手机竖屏用左侧 Drawer 装长表单 → 该用 BottomSheet（P10）或独立页。</string>
    <string name="ot_demo_text_35">Popconfirm = 贴着按钮的小气泡，就地二次确认轻量操作，不遮整页。</string>
    <string name="ot_demo_text_36">列表已空。点下面的「恢复全部」再来一遍。</string>
    <string name="ot_demo_text_37">恢复全部</string>
    <string name="ot_demo_text_38">Android 对应：DropdownMenu 自动锚定并在空间不足时翻到上方；要自定义箭头/位置才用底层 Popup。</string>
    <string name="ot_demo_text_39">反例对照：确认「清空全部数据」这种重操作 → 该用 Modal（P03）写清后果。</string>
    <string name="ot_demo_text_4">弹出 Alert：存储即将写满</string>
    <string name="ot_demo_text_40">Tooltip = 纯文字注解，长按出现、自动消失、不可交互。移动端没有 hover，等价触发是长按。</string>
    <string name="ot_demo_text_41">控制是否推送与免打扰时段</string>
    <string name="ot_demo_text_42">上次同步 12 分钟前，仅 Wi-Fi 下自动</string>
    <string name="ot_demo_text_43">已禁用：需要先完成实名认证</string>
    <string name="ot_demo_text_44">长按任意图标试试：1.8s 后自动消失，点外部也可关。</string>
    <string name="ot_demo_text_45">无障碍要点：图标已设 contentDescription，读屏拿得到同样信息——必要说明不能只藏在 Tooltip 里。</string>
    <string name="ot_demo_text_46">反例对照：Tooltip 里塞按钮/链接 → 那是 Popover（P09）。</string>
    <string name="ot_demo_text_47">Snackbar = 应用内底部条幅，可带一个操作；删除后给「撤销」是它的典型用法。</string>
    <string name="ot_demo_text_48">三条草稿都删完了。等 Snackbar 消失后重进本页可复位。</string>
    <string name="ot_demo_text_49">恢复全部草稿</string>
    <string name="ot_demo_text_5">反例对照：把「保存成功」做成 Alert 就是滥用——那该是 Toast（P02）。</string>
    <string name="ot_demo_text_50">反例对照：Snackbar 里放两个以上操作 → 那已经是工具栏了；报致命错误 → 用 Modal（P03）。</string>
    <string name="ot_demo_text_51">Popover = 锚定的富内容气泡：可放菜单项、开关、输入；Tooltip 的「能干活」版本。</string>
    <string name="ot_demo_text_52">更多操作 ⋯</string>
    <string name="ot_demo_text_53">生成链接发给同事</string>
    <string name="ot_demo_text_54">CSV / PDF 两种格式</string>
    <string name="ot_demo_text_55">从列表移走但可恢复</string>
    <string name="ot_demo_text_56">接收通知</string>
    <string name="ot_demo_text_57">气泡内每行热区 ≥44dp；内容超过 6 项或需要滚动时改用 BottomSheet（P10）。</string>
    <string name="ot_demo_text_58">反例对照：气泡里再弹气泡、或点外部不关闭，都是常见错法。</string>
    <string name="ot_demo_text_59">分享到微信</string>
    <string name="ot_demo_text_6">存储即将写满</string>
    <string name="ot_demo_text_60">复制链接</string>
    <string name="ot_demo_text_61">导出 PDF</string>
    <string name="ot_demo_text_62">移动到归档</string>
    <string name="ot_demo_text_63">删除</string>
    <string name="ot_demo_text_64">加载反馈分三档强度：非阻塞 → 按钮内 → 全局遮罩。强度越高越要给进度与取消。</string>
    <string name="ot_demo_text_65">非阻塞</string>
    <string name="ot_demo_text_66">按钮内</string>
    <string name="ot_demo_text_67">全局遮罩</string>
    <string name="ot_demo_text_68">顶部细进度条：用户仍可继续操作，适合后台刷新/分页加载。</string>
    <string name="ot_demo_text_69">提交表单</string>
    <string name="ot_demo_text_7">剩余空间不足 200MB，继续录制可能中断。这是 Alert：只告知事实，不让你选。</string>
    <string name="ot_demo_text_70">开始关键操作</string>
    <string name="ot_demo_text_71">后台刷新</string>
    <string name="ot_demo_text_72">按钮加载态：宽度不变（只换文案 + 16dp 圆环），防止布局跳动；同时禁止重复提交。</string>
    <string name="ot_demo_text_73">全局遮罩必须给取消或超时兜底，否则网络一断就永远转圈。</string>
    <string name="ot_demo_text_74">反例对照：点一下按钮就整页转圈；加载完不给结果反馈（应接 Toast/Snackbar）。</string>
    <string name="ot_demo_text_75">Badge = 附着在图标上的持续状态：不弹出、不打断，被消费后才消失。</string>
    <string name="ot_demo_text_76">有更新</string>
    <string name="ot_demo_text_77">无更新</string>
    <string name="ot_demo_text_78">计数角标 vs 红点</string>
    <string name="ot_demo_text_79">数字用于「有多少」，红点用于「有更新但不计数」</string>
    <string name="ot_demo_text_8">知道了</string>
    <string name="ot_demo_text_80">设为 100</string>
    <string name="ot_demo_text_81">清零</string>
    <string name="ot_demo_text_82">红点开</string>
    <string name="ot_demo_text_83">规则：count &gt; 99 显示「99+」；count == 0 时整个角标不渲染，不是显示「0」。</string>
    <string name="ot_demo_text_84">反例对照：红点永远消不掉（没有消费逻辑）、角标遮住图标主体超过 1/3。</string>
    <string name="ot_demo_text_9">Toast = 最弱反馈：不打断、无按钮、自动消失。</string>

